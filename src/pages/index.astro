---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import newsData from '../data/news.json';
import policyData from '../data/policy.json';
import { TAGS } from '../../scripts/categorize.mjs';

interface NewsItem {
  title: string;
  link: string;
  source: string;
  lang: 'zh' | 'en';
  pubDate: string;
  summary: string;
  heat: number;
  tags?: string[];
  companies?: string[];
  titleZh?: string;
  summaryZh?: string;
}

// RSS 资讯，数据已由抓取脚本按热度降序排好
const rssItems = (newsData.items || []) as NewsItem[];

// 政策通知（北上广深 + 工信部，fetch-policy.mjs 输出，按时间倒序最新 5 条）
// 统一打上「最新资讯」标签，热度计 0 排在「全部」列表末尾
interface PolicyItem {
  title: string;
  link: string;
  source: string;
  pubDate: string;
  summary: string;
}
const policyItems: NewsItem[] = ((policyData.items || []) as PolicyItem[]).map((p) => ({
  ...p,
  lang: 'zh',
  heat: 0,
  tags: ['最新资讯'],
}));

// 合并所有资讯并按发布时间降序排序
const items = [...rssItems, ...policyItems].sort(
  (a, b) => Date.parse(b.pubDate) - Date.parse(a.pubDate)
);

// 每日 AI 日报：RSS 资讯中最新一天（本地时区）热度最高的 5 条（不含政策通知）
function localDay(iso: string) {
  const d = new Date(iso);
  return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
}
const latestPubIso = rssItems.length ? rssItems.map((i) => i.pubDate).sort().reverse()[0] : '';
const latestPub = latestPubIso ? new Date(latestPubIso) : null;
const latestDay = latestPub ? localDay(latestPubIso) : '';
const dailyDateText = latestPub
  ? `${latestPub.getFullYear()}年${latestPub.getMonth() + 1}月${latestPub.getDate()}日`
  : '';
const dailyLinks = new Set(
  rssItems.filter((i) => localDay(i.pubDate) === latestDay).slice(0, 5).map((i) => i.link)
);

// AI 公司动态：按公司分组，组内按时间降序，组间按最新一条的时间降序（不含政策通知）
const companyMap = new Map<string, NewsItem[]>();
for (const item of rssItems) {
  for (const c of item.companies || []) {
    if (!companyMap.has(c)) companyMap.set(c, []);
    companyMap.get(c)!.push(item);
  }
}
const companyGroups = [...companyMap.entries()]
  .map(([name, list]) => ({
    name,
    list: [...list].sort((a, b) => Date.parse(b.pubDate) - Date.parse(a.pubDate)),
  }))
  .sort((a, b) => Date.parse(b.list[0].pubDate) - Date.parse(a.list[0].pubDate));

// 按日期分组，每组最多显示 10 条，超出折叠
function localDayKey(iso: string) {
  const d = new Date(iso);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
function formatDateHeader(iso: string) {
  const d = new Date(iso);
  const weekdays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  return `${d.getMonth() + 1}月${d.getDate()}日 ${weekdays[d.getDay()]}`;
}
const dayMap = new Map<string, { dateLabel: string; items: NewsItem[] }>();
for (const item of items) {
  const key = localDayKey(item.pubDate);
  if (!dayMap.has(key)) {
    dayMap.set(key, { dateLabel: formatDateHeader(item.pubDate), items: [] });
  }
  dayMap.get(key)!.items.push(item);
}
const dayGroups = [...dayMap.entries()]
  .map(([dateKey, { dateLabel, items }]) => ({ dateKey, dateLabel, items }))
  .sort((a, b) => b.dateKey.localeCompare(a.dateKey));
---
<Layout title="AI 每日资讯">

  <div class="search-bar">
    <input type="search" id="search-input" placeholder="搜索标题、摘要、来源…" autocomplete="off" />
  </div>

  <div class="filters" id="filters" role="group" aria-label="内容筛选">
    <button class="active" data-filter="all" aria-pressed="true">全部</button>
    {policyItems.length > 0 && <button data-filter="tag:最新资讯" aria-pressed="false">最新资讯</button>}
    <button data-filter="daily" aria-pressed="false">AI 日报</button>
    <button data-filter="company" aria-pressed="false">AI 公司动态</button>
    {TAGS.map((t) => <button data-filter={`tag:${t}`} aria-pressed="false">{t}</button>)}
  </div>

  {items.length === 0 && <p class="empty">暂无资讯，请稍后刷新。</p>}

  {dailyLinks.size > 0 && (
    <h2 class="date-group" id="daily-date" style="display:none">AI 日报 · {dailyDateText}</h2>
  )}

  {items.length > 0 && (
    <div id="news-container">
      {dayGroups.map((group) => (
        <div class="day-group" data-date={group.dateKey}>
          <h2 class="date-group">{group.dateLabel}</h2>
          <ul class="news-list">
            {group.items.slice(0, 10).map((item) => (
              <NewsCard item={item} daily={dailyLinks.has(item.link)} compact={true} />
            ))}
          </ul>
          {group.items.length > 10 && (
            <Fragment>
              <div class="folded-items" style="display:none">
                <ul class="news-list">
                  {group.items.slice(10).map((item) => (
                    <NewsCard item={item} daily={dailyLinks.has(item.link)} compact={true} />
                  ))}
                </ul>
              </div>
              <button class="expand-toggle" data-count={group.items.length - 10}>
                展开更多（{group.items.length - 10} 条）
              </button>
            </Fragment>
          )}
        </div>
      ))}
    </div>
  )}

  <p class="empty" id="filter-empty" style="display:none">该筛选下暂无资讯，换个标签试试。</p>

  <div id="company-view" style="display:none">
    {companyGroups.length === 0 && <p class="empty">暂无公司相关资讯。</p>}
    {companyGroups.map(({ name, list }) => (
      <details class="company-block">
        <summary>
          <span class="company-name">{name}</span>
          <span class="company-count">{list.length} 条动态</span>
          <span class="company-latest">{list[0].titleZh || list[0].title}</span>
        </summary>
        <ul class="news-list">
          {list.map((item) => <NewsCard item={item} />)}
        </ul>
      </details>
    ))}
  </div>

  <style>
    .search-bar {
      margin-bottom: 14px;
    }
    .search-bar input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      background: var(--card);
      color: var(--text);
      outline: none;
      transition: border-color 0.15s ease;
      box-sizing: border-box;
    }
    .search-bar input:focus {
      border-color: var(--accent);
    }
    .search-bar input::placeholder {
      color: var(--muted);
    }
  </style>

  <script>
    let searchQuery = '';
    const buttons = document.querySelectorAll('#filters button');
    const newsContainer = document.getElementById('news-container') as HTMLElement;
    const companyView = document.getElementById('company-view') as HTMLElement;
    const filterEmpty = document.getElementById('filter-empty') as HTMLElement;
    const dailyDate = document.getElementById('daily-date');
    const dayGroups = document.querySelectorAll('.day-group');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;

    function applyFilter(filter: string, updateHash = true) {
      buttons.forEach((b) => {
        const active = (b as HTMLElement).dataset.filter === filter;
        b.classList.toggle('active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (dailyDate) dailyDate.style.display = filter === 'daily' ? '' : 'none';
      if (filter === 'company') {
        newsContainer.style.display = 'none';
        companyView.style.display = '';
        // 搜索筛选公司动态视图
        if (searchQuery) {
          const details = companyView.querySelectorAll('.company-block');
          let totalVisible = 0;
          details.forEach((detail) => {
            const cards = detail.querySelectorAll('.news-card');
            let visible = 0;
            cards.forEach((card) => {
              const el = card as HTMLElement;
              const text = (el.textContent || '').toLowerCase();
              if (text.includes(searchQuery)) { el.style.display = ''; visible++; }
              else { el.style.display = 'none'; }
            });
            const detailEl = detail as HTMLElement;
            if (visible > 0) {
              (detail as HTMLDetailsElement).open = true;
              detailEl.style.display = '';
              totalVisible += visible;
            } else {
              detailEl.style.display = 'none';
            }
          });
          filterEmpty.textContent = '未找到相关资讯，换个关键词试试。';
          filterEmpty.style.display = totalVisible === 0 ? '' : 'none';
        } else {
          filterEmpty.style.display = 'none';
          companyView.querySelectorAll('.news-card').forEach((c) => { (c as HTMLElement).style.display = ''; });
          companyView.querySelectorAll('.company-block').forEach((d) => {
            (d as HTMLElement).style.display = '';
            (d as HTMLDetailsElement).open = false;
          });
        }
      } else {
        companyView.style.display = 'none';
        newsContainer.style.display = '';
        const isAll = filter === 'all';
        let totalVisible = 0;
        dayGroups.forEach((group) => {
          const groupEl = group as HTMLElement;
          const allCards = groupEl.querySelectorAll('.news-card');
          const foldedContainer = groupEl.querySelector('.folded-items') as HTMLElement | null;
          const toggleBtn = groupEl.querySelector('.expand-toggle') as HTMLElement | null;
          let groupVisible = 0;
          allCards.forEach((card) => {
            const el = card as HTMLElement;
            let show = true;
            if (filter === 'daily') show = el.dataset.daily === '1';
            else if (filter.startsWith('tag:')) {
              show = (el.dataset.tags || '').split('|').includes(filter.slice(4));
            }
            if (show && searchQuery) {
              show = ((el.textContent || '').toLowerCase()).includes(searchQuery);
            }
            el.style.display = show ? '' : 'none';
            if (show) groupVisible++;
          });
          // 折叠区在「全部」视图下保持折叠；筛选或搜索时自动展开含匹配项的折叠区
          if (foldedContainer && toggleBtn) {
            if (isAll && !searchQuery) {
              foldedContainer.style.display = 'none';
              toggleBtn.style.display = '';
              toggleBtn.textContent = `展开更多（${toggleBtn.dataset.count} 条）`;
            } else {
              const foldedHasVisible = [...foldedContainer.querySelectorAll('.news-card')].some(
                (c) => (c as HTMLElement).style.display !== 'none'
              );
              if (foldedHasVisible) {
                foldedContainer.style.display = '';
                toggleBtn.style.display = 'none';
              } else {
                foldedContainer.style.display = 'none';
                toggleBtn.style.display = 'none';
              }
            }
          }
          groupEl.style.display = groupVisible > 0 ? '' : 'none';
          totalVisible += groupVisible;
        });
        filterEmpty.textContent = searchQuery
          ? '未找到相关资讯，换个关键词试试。'
          : '该筛选下暂无资讯，换个标签试试。';
        filterEmpty.style.display = totalVisible === 0 ? '' : 'none';
      }
      // 筛选状态写入 URL hash，支持分享链接与浏览器前进后退
      if (updateHash) {
        const hash = filter === 'all' ? '#' : `#${encodeURIComponent(filter)}`;
        if (location.hash !== hash) location.hash = hash;
      }
    }

    // 搜索输入：实时筛选
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      const activeBtn = document.querySelector('#filters button.active') as HTMLElement;
      applyFilter(activeBtn?.dataset.filter || 'all', false);
    });

    // 展开/收起折叠区
    document.querySelectorAll('.expand-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const btnEl = btn as HTMLElement;
        const folded = btnEl.previousElementSibling as HTMLElement | null;
        if (!folded || !folded.classList.contains('folded-items')) return;
        const isHidden = folded.style.display === 'none';
        folded.style.display = isHidden ? '' : 'none';
        btnEl.textContent = isHidden ? '收起' : `展开更多（${btnEl.dataset.count} 条）`;
      });
    });

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => applyFilter((btn as HTMLElement).dataset.filter || 'all'))
    );

    const knownFilters = [...buttons].map((b) => (b as HTMLElement).dataset.filter || '');
    window.addEventListener('hashchange', () => {
      const f = decodeURIComponent(location.hash.slice(1));
      if (knownFilters.includes(f)) applyFilter(f, false);
    });
    const initial = decodeURIComponent(location.hash.slice(1));
    if (knownFilters.includes(initial)) applyFilter(initial, false);
  </script>
</Layout>
